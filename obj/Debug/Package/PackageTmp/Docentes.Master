<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Docentes.master.cs" Inherits="PresentismoWebI46.Docentes" %>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Planilla Diaria de Presentismo - Control de Asistencia</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Estilos Propios -->
    <link rel="stylesheet" href="Estilos/css/styles.css">
</head>
<body class="min-h-screen bg-slate-100/70 antialiased font-sans text-slate-800">
    <!-- Navbar Global Dinámico -->
    <div id="navbar-container">
        <nav class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-2xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          
          <!-- Logo y Marca -->
          <div class="flex items-center gap-4">
            <a href="asistencia.html" class="flex items-center gap-2.5 text-slate-900 no-underline">
              <div class="w-9 h-9 rounded-xl bg-indigo-600 text-white flex items-center justify-center font-bold text-base shadow-sm">
                <i class="fa-solid fa-graduation-cap"></i>
              </div>
              <div class="hidden sm:block">
                <span class="block text-xs font-black tracking-wider text-slate-800 uppercase leading-none">INSTITUTO TERCIARIO</span>
                <span class="block text-[10px] text-slate-500 font-semibold tracking-tight mt-0.5">Control de Presentismo</span>
              </div>
            </a>

            <!-- Selector de Materia Activa -->
            
      <div class="flex items-center gap-1.5 bg-slate-100 px-3 py-1.5 rounded-xl border border-slate-200 text-xs">
        <i class="fa-solid fa-graduation-cap text-indigo-600"></i>
        <select id="global-course-select" onchange="handleNavbarCourseChange(this.value)" class="bg-transparent font-bold text-slate-800 focus:outline-none cursor-pointer">
          
            <option value="c1" selected="">
              Desarrollo de Software I (1er Año)
            </option>
          
        </select>
      </div>
          </div>

          <!-- Enlaces de Navegación -->
          <div class="hidden md:flex items-center gap-1.5">
            
      <a href="WF_Docente_Asistencia.aspx" class="nav-link active">
        <i class="fa-solid fa-clipboard-check"></i>
        <span>Planilla Diaria</span>
      </a>
      <a href="WF_Docente_Reporte.aspx" class="nav-link ">
        <i class="fa-solid fa-file-excel text-emerald-600"></i>
        <span>Sábana Mensual</span>
      </a>
      <a href="WF_Docente_Alumnos.aspx" class="nav-link ">
        <i class="fa-solid fa-users"></i>
        <span>Alumnos</span>
      </a>
    
          </div>

          <!-- Perfil de Usuario y Logout -->
          <div class="flex items-center gap-3">
            
              <div class="flex items-center gap-2.5 pl-3 border-l border-slate-200">
                <div class="text-right hidden sm:block">
                  <span class="block text-xs font-bold text-slate-800 leading-tight">Prof. Carlos Rodríguez</span>
                  <span class="block text-[10px] font-semibold text-indigo-600 uppercase">
                    Docente
                  </span>
                </div>
                <button type="button" onclick="logout()" title="Cerrar sesión" class="p-2 text-slate-400 hover:text-rose-600 rounded-xl hover:bg-rose-50 transition-colors cursor-pointer">
                  <i class="fa-solid fa-arrow-right-from-bracket text-sm"></i>
                </button>
              </div>
            
          </div>

        </div>
      </div>
    </nav>
    </div>
    <form id="form1" runat="server">
    <div>
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>
    </div>
    </form>
    <!-- Scripts Modulares del Frontend Completo -->
    <%--  <script src="Estilos/js/storage.js"></script>
  <script src="Estilos/js/auth.js"></script>
  <script src="Estilos/js/ui.js"></script>
  <script src="Estilos/js/asistencia.js"></script>--%>
</body>
</html>
