            </option>
          
            <option value="c3">
              Práctica Profesionalizante (3er Año)
            </option>
          
        </select>
      </div>--%>
    
          </div>

          <!-- Enlaces de Navegación -->
          <div class="hidden md:flex items-center gap-1.5">
            
      <a href="WF_Admin_Carreras.aspx" class="nav-link active">
        <i class="fa-solid fa-graduation-cap"></i>
        <span>Carreras</span>
      </a>
      <a href="WF_Admin_Materias.aspx" class="nav-link ">
        <i class="fa-solid fa-book-bookmark"></i>
        <span>Materias</span>
      </a>
      <a href="WF_Admin_Alumnos.aspx" class="nav-link ">
        <i class="fa-solid fa-users"></i>
        <span>Alumnos</span>
      </a>
      <a href="WF_Admin_Docentes.aspx" class="nav-link ">
        <i class="fa-solid fa-chalkboard-user"></i>
        <span>Docentes</span>
      </a>
<%--      <a href="asistencia.html" class="nav-link ">
        <i class="fa-solid fa-clipboard-check"></i>
        <span>Pasar Lista</span>
      </a>
      <a href="reporte-mensual.html" class="nav-link ">
        <i class="fa-solid fa-file-excel text-emerald-600"></i>
        <span>Sábana Mensual</span>
      </a>
    --%>
          </div>

          <!-- Perfil de Usuario y Logout -->
          <div class="flex items-center gap-3">
            
              <div class="flex items-center gap-2.5 pl-3 border-l border-slate-200">
                <div class="text-right hidden sm:block">
                  <span class="block text-xs font-bold text-slate-800 leading-tight">Bedelía Central</span>
                  <span class="block text-[10px] font-semibold text-amber-600 uppercase">
                    Administrativo
                  </span>
                </div>
                <button type="button" onclick="logout()" title="Cerrar sesión" class="p-2 text-slate-400 hover:text-rose-600 rounded-xl hover:bg-rose-50 transition-colors cursor-pointer">
                  <i class="fa-solid fa-arrow-right-from-bracket text-sm"></i>
                </button>
              </div>
            
          </div>

        </div>
      </div>
    </nav>
    </div>
    <form id="form1" runat="server">
    <div>
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>
    </div>
    </form>
    <div id="career-modal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4 z-50 hidden">
        <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-100 space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h3 id="modal-career-title" class="text-sm font-bold text-slate-900 uppercase tracking-wider">
                    Nueva Carrera Académica
                </h3>
                <button type="button" onclick="closeCareerModal()" class="text-slate-400 hover:text-slate-600 text-base">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <form onsubmit="handleSaveCareerSubmit(event)" class="space-y-3.5">
            <div>
                <label class="block text-[11px] font-bold text-slate-700 uppercase mb-1">
                    Nombre Oficial de la Carrera *</label>
                <input id="modal-career-name" type="text" required="" placeholder="Ej: Tecnicatura Superior en Ciencia de Datos"
                    class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:border-indigo-500 focus:bg-white">
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-[11px] font-bold text-slate-700 uppercase mb-1">
                        Sigla / Código *</label>
                    <input id="modal-career-code" type="text" required="" placeholder="Ej: TSCD" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold uppercase focus:outline-none focus:border-indigo-500 focus:bg-white">
                </div>
                <div>
                    <label class="block text-[11px] font-bold text-slate-700 uppercase mb-1">
                        Duración (Años) *</label>
                    <input id="modal-career-duration" type="number" min="1" max="6" value="3" required=""
                        class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:border-indigo-500 focus:bg-white">
                </div>
            </div>
            <div>
                <label class="block text-[11px] font-bold text-slate-700 uppercase mb-1">
                    Resolución Ministerial / Expediente</label>
                <input id="modal-career-resolution" type="text" placeholder="Ej: Res. Ministerial N° 340/23"
                    class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:border-indigo-500 focus:bg-white">
            </div>
            <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100">
                <button type="button" onclick="closeCareerModal()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl cursor-pointer">
                    Cancelar
                </button>
                <button type="submit" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow-xs cursor-pointer">
                    Guardar Carrera
                </button>
            </div>
            </form>
        </div>
    </div>
</body>
</html>
